# Copy to .env and adjust. The app reads these via python-dotenv at startup.

# Which LLM backend the AI agents use: "k2" (default) or "azure".
LLM_PROVIDER=k2

# --- K2-Think (default; OpenAI-compatible reasoning model) ---
K2_API_KEY=your-k2-api-key-here
K2_BASE_URL=https://api.k2think.ai/v1
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# Optional: pool of keys, comma-separated, round-robined across players for
# rate-limit headroom during parallel night/voting calls. If set, this overrides
# K2_API_KEY. Put all your keys here (no spaces needed, but trimmed anyway):
# K2_API_KEYS=IFM-key1,IFM-key2,IFM-key3,IFM-key4,IFM-key5

# --- Azure OpenAI (only used when LLM_PROVIDER=azure) ---
# The original hardcoded resource no longer exists; supply your own to use Azure.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=VARELab-GPT4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Voice / emotion layer (optional; backend-only) ---
VOICE_ENABLED=false
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
VALENCE_API_KEY=your-valence-api-key-here
# Valence discrete emotion endpoint + model (clips must be >= ~4.5s):
# VALENCE_URL=https://api.getvalenceai.com/v1/discrete/emotion
# VALENCE_MODEL=7emotions
